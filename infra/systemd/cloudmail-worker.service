[Unit]
Description=Cloud Mail Background Workers
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=cloudmail
Group=cloudmail
WorkingDirectory=/opt/cloudmail/current/apps/api
EnvironmentFile=/etc/cloudmail/api.env
ExecStart=/usr/bin/node dist/workers/index.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cloudmail /var/log/cloudmail

[Install]
WantedBy=multi-user.target
