<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
  <emailProvider id="cloudmail.dev">
    <domain>digiskills.live</domain>
    <displayName>Cloud Mail</displayName>
    <displayShortName>Cloud Mail</displayShortName>

    <incomingServer type="imap">
      <hostname>mail.digiskills.live</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </incomingServer>

    <outgoingServer type="smtp">
      <hostname>mail.digiskills.live</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </outgoingServer>

    <documentation url="https://mail.digiskills.live/help/connect">
      <descr lang="en">Cloud Mail setup instructions</descr>
    </documentation>
  </emailProvider>
</clientConfig>
