{
  "name": "cloudmail-monorepo",
  "private": true,
  "version": "2.0.0",
  "description": "Cloud Mail — Your Email. Anywhere. (Phase 2 — multi-tenant email hosting platform)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @cloudmail/web run dev",
    "dev:api": "npm --workspace @cloudmail/api run dev",
    "build:web": "npm --workspace @cloudmail/web run build",
    "build:api": "npm --workspace @cloudmail/api run build",
    "build": "npm run build:web && npm run build:api",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "npm --workspaces --if-present run test",
    "prisma:generate": "npm --workspace @cloudmail/api run prisma:generate",
    "prisma:migrate": "npm --workspace @cloudmail/api run prisma:migrate",
    "docker:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
