{
  "name": "@cloudmail/api",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Cloud Mail API — multi-tenant email hosting control plane",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -b --pretty && node -e \"require('fs').cpSync('prisma','dist/prisma',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc -b --pretty",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx src/scripts/seed.ts",
    "worker": "tsx src/workers/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/static": "^8.0.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.5",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "htmlparser2": "^9.1.0",
    "imapflow": "^1.0.171",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.7.2",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16",
    "otpauth": "^9.3.6",
    "qrcode": "^1.5.4",
    "rrule": "^2.8.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
