# ─── Cloud Mail API ────────────────────────────────────────────────
# Copy to apps/api/.env for local dev. NEVER commit real values.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# ─── Database (PostgreSQL) ─────────────────────────────────────────
# Prisma URL. In prod, use a socket or private-network host.
DATABASE_URL=postgresql://cloudmail:cloudmail@localhost:5432/cloudmail?schema=public

# ─── Redis (sessions, rate limit, BullMQ) ─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth secrets (rotate on any suspected compromise) ─────────────
# Generate: openssl rand -hex 48
JWT_ACCESS_SECRET=change_me_dev_only__generate_with_openssl_rand_hex_48
JWT_REFRESH_SECRET=change_me_dev_only__generate_with_openssl_rand_hex_48
JWT_ACCESS_TTL=900          # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000     # 30 days (seconds)

# ─── Mail infrastructure (server-side; used by API to talk to Dovecot/Postfix) ─
# Once mail.digiskills.live is live, point these at the mail server.
# For local dev without a mail box, leave as localhost placeholders.
IMAP_HOST=127.0.0.1
IMAP_PORT=143
IMAP_SECURE=false           # true for port 993 (implicit TLS)
IMAP_STARTTLS=true          # true for STARTTLS on 143

SMTP_SUBMISSION_HOST=127.0.0.1
SMTP_SUBMISSION_PORT=587
SMTP_SUBMISSION_SECURE=false
SMTP_SUBMISSION_STARTTLS=true

# Dovecot master password (used to log in as any user for API IMAP calls).
# Configure `auth_master_user_separator = *` and a master passdb in dovecot.
DOVECOT_MASTER_USER=cloudmail-api
DOVECOT_MASTER_PASSWORD=change_me_dev_only

# ─── Cloud Mail hostnames (initial deployment) ────────────────────
CLOUDMAIL_PLATFORM_DOMAIN=cloudmail.dev              # future canonical
CLOUDMAIL_INITIAL_MAIL_HOST=mail.digiskills.live     # this box's public hostname
CLOUDMAIL_INITIAL_IPV4=167.233.22.55

# ─── Storage ───────────────────────────────────────────────────────
# Where uploaded attachments (in-flight) are staged before being sent.
UPLOAD_TMP_DIR=./.uploads

# ─── Observability ─────────────────────────────────────────────────
LOG_LEVEL=info               # trace | debug | info | warn | error
